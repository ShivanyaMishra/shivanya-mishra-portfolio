# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================
# EMAIL DELIVERY CONFIGURATION (Direct Portfolio Message Forwarding)
# ==============================================================
# EMAIL_TO: Recipient address for portfolio contact messages
EMAIL_TO="shivanyamishra84@gmail.com"

# OPTION 1: GMAIL SMTP (Recommended)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="shivanyamishra84@gmail.com"
SMTP_PASS="your-16-character-app-password"

# OPTION 2: RESEND API (Alternative modern email provider)
# If using Resend, obtain an API key from https://resend.com
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="onboarding@resend.dev"

# OPTION 3: CUSTOM SMTP (SendGrid, Brevo, Mailgun, Amazon SES, Outlook)
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="apikey"
# SMTP_PASS="your-sendgrid-api-key"
